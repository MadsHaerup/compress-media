{
	"name": "@avalon/compress-media",
	"version": "1.0.0",
	"description": "Powerful media compression library for Deno with WebP, AVIF, and video support",
	"license": "MIT",
	"author": "avalon Team",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/avalon-land/compress-media.git"
	},
	"keywords": ["deno", "media", "compression", "webp", "avif", "video", "ffmpeg", "sharp", "image-optimization"],

	"exports": {
		".": "./mod.ts",
		"./image": "./image-compression.ts",
		"./video": "./video-compression.ts",
		"./media": "./media-compression.ts",
		"./cli": "./cli.ts"
	},

	"imports": {
		"@std/fs": "jsr:@std/fs@^1.0.8",
		"@std/path": "jsr:@std/path@^1.0.8"
	},

	"tasks": {
		"compress": "deno run --allow-all cli.ts",
		"check-deps": "deno run --allow-run cli.ts --check-deps",
		"install-deps": "deno run --allow-run cli.ts --install-deps",
		"test": "deno test --allow-all",
		"lint": "deno lint",
		"fmt": "deno fmt"
	},

	"compilerOptions": {
		"lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
		"strict": true
	},

	"nodeModulesDir": "auto"
}
